# NEXORA Authentication & Session Configuration
# Generate a strong 32+ character random secret for production: `openssl rand -hex 32`
AUTH_SECRET=nexora-development-secret-key-min-32-chars-long-change-in-production

# Base application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional SMTP Configuration for Production Password Reset Emails
# In development, reset links are displayed directly in the UI if SMTP is not configured.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-smtp-api-key
# SMTP_FROM=NEXORA <support@nexora.ai>
